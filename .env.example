# Optional. `docker compose up` works with none of this: every value below already has a
# DEMO-ONLY default in docker-compose.yml. Copy this file to `.env` only to override one.
# Never put real secrets in this example file.

# Host port for the web app (default 8080).
# WEB_PORT=8080

# Password for the demo accounts (admin, manager, staff, technician, warehouse). Default: Demo!2026
# DEMO_PASSWORD=Demo!2026

# JWT signing key: at least 32 characters. Changing it signs everyone out.
# JWT_KEY=change-me-to-a-long-random-string-of-32-or-more-characters

# SQL Server 'sa' password: needs 8+ chars with upper, lower, digit and symbol. Avoid ';' and '='.
# MSSQL_SA_PASSWORD=Demo_Passw0rd!

# Host port for optional direct SQL access (bound to 127.0.0.1 only). Default 14330.
# SQL_HOST_PORT=14330
